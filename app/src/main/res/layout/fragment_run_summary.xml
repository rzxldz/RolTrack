<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/runExportCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivSummaryLogo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/roltrack_logo"
            android:contentDescription="Logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvSummaryBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.10"
            android:text="ROLTRACK"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSummaryDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="0.00 km"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSummaryTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="00:00"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvSummaryPace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="--:-- /km"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <com.example.roltrack.running.RoutePreviewView
            android:id="@+id/routePreviewView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="32dp"
            android:background="@color/background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportPng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Exportar PNG" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSharePng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Compartir imagen" />
    </LinearLayout>
</ScrollView>