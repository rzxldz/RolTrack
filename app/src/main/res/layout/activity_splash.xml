<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/roltrack_logo"
            android:contentDescription="RolTrack Logo"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="ROLTRACK"
            android:textColor="@color/primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Track your progress"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

</FrameLayout>